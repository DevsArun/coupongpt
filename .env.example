# =====================================================================
# CouponGPT — environment configuration
# Copy to .env and fill in. NEVER commit the real .env.
# =====================================================================

# ---- App ----
APP_NAME=CouponGPT
APP_ENV=development            # development | staging | production
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-long-random-string
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ---- MySQL ----
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=coupongpt
MYSQL_PASSWORD=coupongpt_pw
MYSQL_DATABASE=coupongpt
# Async driver: aiomysql (pure-Python, no build step — best for HF Spaces) or asyncmy
MYSQL_DRIVER=aiomysql
# Optional full DSN override (takes precedence if set)
# DATABASE_URL=mysql+aiomysql://user:pass@host:3306/coupongpt

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# REDIS_URL=redis://:password@host:6379/0

# ---- Meilisearch ----
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=change-me-meili-master-key
MEILI_INDEX_COUPONS=coupons

# ---- JWT / Auth ----
JWT_SECRET=change-me-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_BCRYPT_ROUNDS=12

# ---- AI providers (fallback chain: Groq -> Gemini -> OpenAI) ----
AI_PROVIDER_PRIORITY=groq,gemini,openai
AI_REQUEST_TIMEOUT=8

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Stripe ----
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Razorpay ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Rate limiting ----
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_SEARCH_PER_MINUTE=30

# ---- Frontend (PHP) ----
# Where the PHP tier reaches the backend (server-to-server)
BACKEND_BASE_URL=http://backend:8000
FRONTEND_BASE_URL=http://localhost:8080
SESSION_SECRET=change-me-session-secret

# ---- Observability ----
LOG_LEVEL=INFO
LOG_JSON=true
SENTRY_DSN=

# ---- Production / serving ----
# Number of uvicorn workers (set >1 in production, behind a reverse proxy).
WEB_CONCURRENCY=1
# Honour X-Forwarded-For/X-Real-IP (enable ONLY behind a trusted proxy).
TRUST_PROXY_HEADERS=false
# Comma-separated Host allow-list (use specific hosts in production; * disables).
ALLOWED_HOSTS=*
# Public base URL used to build links (e.g. password-reset emails).
APP_BASE_URL=http://localhost:8080

# ---- Email (password reset & notifications) ----
EMAIL_BACKEND=console          # console | smtp
EMAIL_FROM=CouponGPT <no-reply@coupongpt.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# ---- Background scheduler (app.worker) ----
SCHEDULER_ENABLED=false
INGEST_INTERVAL_SECONDS=21600        # 6h; 0 disables
EXPIRE_INTERVAL_SECONDS=3600         # 1h; 0 disables
PAYMENT_RETRY_INTERVAL_SECONDS=3600  # 1h; 0 disables
